<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="001-create-schema" author="digicart" runAlways="true">
        <validCheckSum>ANY</validCheckSum>
        <sql>CREATE SCHEMA IF NOT EXISTS shipping_svc</sql>
    </changeSet>

    <changeSet id="002-create-shipper-config" author="digicart">
        <createTable tableName="shipper_config" schemaName="shipping_svc">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="store_id" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="pickup_pincode" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="default_weight" type="DOUBLE PRECISION" defaultValueNumeric="0.5"/>
            <column name="active_provider" type="VARCHAR(255)"/>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="shipper_config" schemaName="shipping_svc" indexName="idx_shipper_config_store_id">
            <column name="store_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="003-create-shipping-provider-config" author="digicart">
        <createTable tableName="shipping_provider_config" schemaName="shipping_svc">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="store_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="provider" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="credentials" type="JSONB" defaultValue="{}">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="shipping_provider_config" schemaName="shipping_svc" indexName="idx_shipping_provider_config_store_id">
            <column name="store_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="004-create-shipment" author="digicart">
        <createTable tableName="shipment" schemaName="shipping_svc">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="store_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="order_id" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="provider" type="VARCHAR(255)"/>
            <column name="awb_number" type="VARCHAR(255)"/>
            <column name="label_url" type="TEXT"/>
            <column name="tracking_status" type="VARCHAR(255)"/>
            <column name="tracking_url" type="TEXT"/>
            <column name="status" type="VARCHAR(255)" defaultValue="CREATED">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="shipment" schemaName="shipping_svc" indexName="idx_shipment_store_id">
            <column name="store_id"/>
        </createIndex>
        <createIndex tableName="shipment" schemaName="shipping_svc" indexName="idx_shipment_order_id">
            <column name="order_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="005-create-return-shipment" author="digicart">
        <createTable tableName="return_shipment" schemaName="shipping_svc">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="store_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="order_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="return_id" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="provider" type="VARCHAR(255)"/>
            <column name="awb_number" type="VARCHAR(255)"/>
            <column name="status" type="VARCHAR(255)" defaultValue="CREATED">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="return_shipment" schemaName="shipping_svc" indexName="idx_return_shipment_store_id">
            <column name="store_id"/>
        </createIndex>
        <createIndex tableName="return_shipment" schemaName="shipping_svc" indexName="idx_return_shipment_order_id">
            <column name="order_id"/>
        </createIndex>
        <createIndex tableName="return_shipment" schemaName="shipping_svc" indexName="idx_return_shipment_return_id">
            <column name="return_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="006-create-pincode-fallback" author="digicart">
        <createTable tableName="pincode_fallback" schemaName="shipping_svc">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="store_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="pincode" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="charge" type="DOUBLE PRECISION">
                <constraints nullable="false"/>
            </column>
            <column name="label" type="VARCHAR(255)"/>
        </createTable>
        <createIndex tableName="pincode_fallback" schemaName="shipping_svc" indexName="idx_pincode_fallback_store_id">
            <column name="store_id"/>
        </createIndex>
        <createIndex tableName="pincode_fallback" schemaName="shipping_svc" indexName="idx_pincode_fallback_pincode">
            <column name="pincode"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
